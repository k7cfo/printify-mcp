# Personal access token from Printify → My Profile → Connections.
# The server reads this from the environment only. It is never a tool argument,
# and it is never written to logs or tool results.
# PRINTIFY_API_KEY is ignored.
PRINTIFY_API_TOKEN=

# Optional. Numeric shop id from the list_shops tool.
# When unset, shop tools use the account only when it has exactly one shop.
# PRINTIFY_SHOP_ID=
