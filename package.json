{
  "name": "@tsavo/printify-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Printify REST API: shops, catalog, products, uploads, and publishing",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "dist/index.d.ts",
  "bin": {
    "printify-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "mcp",
    "printify",
    "llm",
    "ai",
    "claude",
    "anthropic",
    "model-context-protocol",
    "print-on-demand"
  ],
  "author": "TSavo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k7cfo/printify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/k7cfo/printify-mcp/issues"
  },
  "homepage": "https://github.com/k7cfo/printify-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.3"
  }
}
